<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherTasks"
            prefWidth="1300" prefHeight="700"
            stylesheets="@modern-tech-style.css">

   <top>
      <VBox spacing="8" styleClass="tech-panel">
         <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="12">
            <Region styleClass="status-success" prefWidth="12" prefHeight="12"/>
            <Label text="EMPLOYEE TASKS MANAGEMENT" styleClass="title-label"/>
         </HBox>
         <Label text="Assign and monitor employee tasks" styleClass="subtitle-label"
                style="-fx-padding: 0 0 0 24px;"/>

         <HBox spacing="30" alignment="CENTER_LEFT">
            <padding><Insets top="15"/></padding>
            <VBox spacing="4">
               <Label text="TOTAL TASKS"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblTotalTasks" text="0"
                      style="-fx-text-fill: #00c853; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="40"/>
            <VBox spacing="4">
               <Label text="TODAY'S TASKS"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblTodayTasks" text="0"
                      style="-fx-text-fill: #1a73e8; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="40"/>
            <VBox spacing="4">
               <Label text="⭐ AVG RATING"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblAvgRating" text="0.0"
                      style="-fx-text-fill: #ff9800; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="40"/>
            <VBox spacing="4">
               <Label text="LAST UPDATED"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblLastUpdate" text="Just now"
                      style="-fx-text-fill: #e6edf3; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </VBox>
         </HBox>
      </VBox>
   </top>

   <center>
      <VBox spacing="15">
         <padding>
            <Insets top="20" right="25" bottom="10" left="25"/>
         </padding>

         <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch"
                       promptText="🔍 Search by employee name, position or description..."
                       prefWidth="420" prefHeight="42"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↻ Refresh"
                    onAction="#refreshTable"
                    styleClass="button-secondary"
                    prefHeight="42"/>
         </HBox>

         <TableView fx:id="tableTask" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colEmployeeName" text="EMPLOYEE" prefWidth="250"/>
               <TableColumn fx:id="colDescription" text="TASK DESCRIPTION" prefWidth="350"/>
               <TableColumn fx:id="colDate" text="DATE" prefWidth="130"/>
               <TableColumn fx:id="colRating" text="RATING" prefWidth="180"/>
               <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="120"/>
            </columns>
            <placeholder>
               <VBox spacing="10" alignment="CENTER">
                  <Label text="📋" style="-fx-font-size: 48px;"/>
                  <Label text="No tasks found"
                         style="-fx-text-fill: #8b949e; -fx-font-size: 16px;"/>
                  <Label text="Click '+ Add New Task' to get started"
                         style="-fx-text-fill: #6e7681; -fx-font-size: 13px;"/>
               </VBox>
            </placeholder>
         </TableView>
      </VBox>
   </center>

   <bottom>
      <HBox spacing="12" alignment="CENTER"
            style="-fx-background-color: #1e293b; -fx-border-color: #30363d;
                   -fx-border-width: 1px 0 0 0; -fx-padding: 18px 30px;">

         <Button text="+ Add New Task"
                 onAction="#addNewTask"
                 styleClass="button-success"
                 prefHeight="45" prefWidth="170"
                 style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

         <Button text="✏ Edit Selected"
                 onAction="#editTask"
                 prefHeight="45" prefWidth="150"
                 style="-fx-font-size: 13px;"/>

         <Button text="🗑 Delete Selected"
                 onAction="#deleteTask"
                 styleClass="button-danger"
                 prefHeight="45" prefWidth="170"
                 style="-fx-font-size: 13px;"/>

         <Region HBox.hgrow="ALWAYS"/>

         <Button text="← Back to Employees"
                 onAction="#backToEmployees"
                 styleClass="button-secondary"
                 prefHeight="45" prefWidth="190"
                 style="-fx-font-size: 13px;"/>
      </HBox>
   </bottom>

</BorderPane>
