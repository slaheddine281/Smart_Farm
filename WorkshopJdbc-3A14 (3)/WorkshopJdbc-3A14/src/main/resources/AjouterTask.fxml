<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AjouterTask"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: #1e293b;">

   <top>
      <VBox spacing="8" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #1a365d 0%, #0f766e 100%); -fx-padding: 25px;">
         <Label text="ADD NEW TASK" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
         <Label text="Assign a task to an employee" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;"/>
      </VBox>
   </top>

   <center>
      <VBox spacing="25" style="-fx-padding: 30px;">

         <!-- Employee Selection -->
         <VBox spacing="8">
            <Label text="👤 EMPLOYEE" style="-fx-text-fill: #00c853; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label text="Select Employee *" style="-fx-text-fill: #e6edf3; -fx-font-size: 14px;"/>
            <ComboBox fx:id="cmbEmployee" promptText="Select an employee..." prefWidth="540" prefHeight="42"
                     style="-fx-background-color: #30363d; -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #8b949e;
                            -fx-font-size: 13px; -fx-background-radius: 8px;"/>
         </VBox>

         <!-- Task Description -->
         <VBox spacing="8">
            <Label text="📋 TASK DETAILS" style="-fx-text-fill: #1a73e8; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label text="Task Description *" style="-fx-text-fill: #e6edf3; -fx-font-size: 14px;"/>
            <TextArea fx:id="txtDescription" promptText="Describe the task..." prefHeight="100" wrapText="true"
                     style="-fx-control-inner-background: #30363d; -fx-text-fill: #e6edf3;
                            -fx-prompt-text-fill: #8b949e; -fx-font-size: 13px;
                            -fx-background-radius: 8px; -fx-border-radius: 8px;
                            -fx-border-color: #444d56; -fx-border-width: 1px;"/>
         </VBox>

         <!-- Task Date -->
         <VBox spacing="8">
            <Label text="Task Date *" style="-fx-text-fill: #e6edf3; -fx-font-size: 14px;"/>
            <DatePicker fx:id="datePicker" prefWidth="540" prefHeight="42"
                       style="-fx-background-color: #30363d; -fx-control-inner-background: #30363d;
                              -fx-text-fill: #e6edf3; -fx-font-size: 13px;
                              -fx-background-radius: 8px;"/>
         </VBox>

         <!-- Required fields note -->
         <Label text="* Required fields" style="-fx-text-fill: #8b949e; -fx-font-size: 12px; -fx-font-style: italic;"/>

      </VBox>
   </center>

   <bottom>
      <HBox spacing="12" alignment="CENTER" style="-fx-background-color: #0d1117; -fx-padding: 20px; -fx-border-color: #30363d; -fx-border-width: 1px 0 0 0;">
         <Button text="✓ Add Task" onAction="#addTask"
                style="-fx-background-color: #00c853; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-padding: 12px 30px; -fx-background-radius: 8px; -fx-cursor: hand;"
                prefWidth="150"/>

         <Button text="↻ Clear" onAction="#clearForm"
                style="-fx-background-color: #30363d; -fx-text-fill: #e6edf3; -fx-font-size: 14px;
                       -fx-padding: 12px 30px; -fx-background-radius: 8px; -fx-cursor: hand;"
                prefWidth="120"/>

         <Button text="← Cancel" onAction="#cancel"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-padding: 12px 30px; -fx-background-radius: 8px; -fx-cursor: hand;"
                prefWidth="120"/>
      </HBox>
   </bottom>

</BorderPane>
