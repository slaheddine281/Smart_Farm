<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AjouterTask"
            prefWidth="650" prefHeight="560"
            stylesheets="@modern-tech-style.css">

    <top>
        <VBox spacing="8" styleClass="tech-panel">
            <padding><Insets top="18" right="25" bottom="18" left="25"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="status-success" prefWidth="12" prefHeight="12"/>
                <Label text="ADD NEW TASK" styleClass="title-label"
                       style="-fx-font-size: 20px;"/>
            </HBox>
            <Label text="Assign a task to an employee" styleClass="subtitle-label"
                   style="-fx-font-size: 13px; -fx-padding: 0 0 0 24px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="60" bottom="20" left="60"/>
            </padding>

            <!-- Employee -->
            <VBox spacing="10" styleClass="card">
                <Label text="👤 EMPLOYEE" styleClass="section-label"
                       style="-fx-text-fill: #00c853; -fx-font-size: 13px;"/>
                <VBox spacing="6">
                    <Label text="Select Employee *"
                           style="-fx-text-fill: #e6edf3; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbEmployee"
                              promptText="Select an employee..."
                              prefWidth="99999" prefHeight="42"/>
                    <Label fx:id="lblEmployeeError" text=""
                           style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
                </VBox>
            </VBox>

            <!-- Task Description -->
            <VBox spacing="10" styleClass="card">
                <Label text="📋 TASK DETAILS" styleClass="section-label"
                       style="-fx-text-fill: #1a73e8; -fx-font-size: 13px;"/>
                <VBox spacing="6">
                    <Label text="Task Description *"
                           style="-fx-text-fill: #e6edf3; -fx-font-weight: bold;"/>
                    <TextArea fx:id="txtDescription"
                              promptText="Describe the task..."
                              prefHeight="100" wrapText="true"
                              style="-fx-background-color: #1f2937; -fx-text-fill: #e6edf3;
                                -fx-border-color: #30363d; -fx-border-radius: 8px;
                                -fx-background-radius: 8px; -fx-font-size: 13px;
                                -fx-padding: 10px;"/>
                    <Label fx:id="lblDescriptionError" text=""
                           style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Task Date *"
                           style="-fx-text-fill: #e6edf3; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpTaskDate"
                                prefWidth="99999" prefHeight="42"
                                style="-fx-background-color: #1f2937;"/>
                    <Label fx:id="lblDateError" text=""
                           style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
                </VBox>
            </VBox>

            <Label text="* Required fields"
                   style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-style: italic;"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER"
              style="-fx-background-color: #1e293b; -fx-border-color: #30363d;
                   -fx-border-width: 1px 0 0 0; -fx-padding: 18px 30px;">
            <Button text="✓ Add Task"
                    onAction="#addTask"
                    styleClass="button-success"
                    prefHeight="45" prefWidth="160"
                    style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Button text="↻ Clear"
                    onAction="#clearForm"
                    styleClass="button-secondary"
                    prefHeight="45" prefWidth="120"
                    style="-fx-font-size: 13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Cancel"
                    onAction="#cancel"
                    prefHeight="45" prefWidth="130"
                    style="-fx-font-size: 13px;"/>
        </HBox>
    </bottom>

</BorderPane>