<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherEmploye"
            prefWidth="1000" prefHeight="700"
            stylesheets="@modern-tech-style.css">

   <!-- TOP HEADER BAR -->
   <top>
      <VBox spacing="0" styleClass="tech-panel">
         <padding>
            <Insets top="25" right="30" bottom="25" left="30"/>
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="15">
            <Region styleClass="status-success" prefWidth="12" prefHeight="12"/>
            <Label text="EMPLOYEE MANAGEMENT SYSTEM" styleClass="title-label"/>
         </HBox>

         <Label text="Manage and monitor your workforce" styleClass="subtitle-label">
            <padding>
               <Insets top="8" left="27"/>
            </padding>
         </Label>

         <!-- Stats Bar -->
         <HBox spacing="30" alignment="CENTER_LEFT">
            <padding>
               <Insets top="20"/>
            </padding>

            <VBox spacing="5" alignment="CENTER_LEFT">
               <Label text="TOTAL EMPLOYEES"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblTotalEmployees" text="0"
                      style="-fx-text-fill: #00c853; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="40"/>

            <VBox spacing="5" alignment="CENTER_LEFT">
               <Label text="ACTIVE POSITIONS"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblActivePositions" text="0"
                      style="-fx-text-fill: #1a73e8; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="40"/>

            <VBox spacing="5" alignment="CENTER_LEFT">
               <Label text="LAST UPDATED"
                      style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-font-weight: bold;"/>
               <Label fx:id="lblLastUpdate" text="Just now"
                      style="-fx-text-fill: #e6edf3; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </VBox>
         </HBox>
      </VBox>
   </top>

   <!-- CENTER - TABLE VIEW -->
   <center>
      <VBox spacing="20">
         <padding>
            <Insets top="25" right="30" bottom="10" left="30"/>
         </padding>

         <!-- Search and Filter Bar -->
         <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch"
                       promptText="🔍 Search by name, position, or phone..."
                       prefWidth="400" prefHeight="42"/>

            <ComboBox fx:id="cmbFilterPosition"
                      promptText="Filter by Position"
                      prefWidth="200" prefHeight="42"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="↻ Refresh"
                    onAction="#refreshTable"
                    styleClass="button-secondary"
                    prefHeight="42"/>
         </HBox>

         <!-- Employee Table -->
         <TableView fx:id="tableEmployes" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId"
                            text="ID"
                            prefWidth="70"
                            style="-fx-alignment: CENTER;"/>
               <TableColumn fx:id="colFirstName"
                            text="FIRST NAME"
                            prefWidth="200"/>
               <TableColumn fx:id="colLastName"
                            text="LAST NAME"
                            prefWidth="200"/>
               <TableColumn fx:id="colPhone"
                            text="PHONE"
                            prefWidth="160"
                            style="-fx-alignment: CENTER;"/>
               <TableColumn fx:id="colPosition"
                            text="POSITION"
                            prefWidth="220"/>
            </columns>
            <placeholder>
               <VBox spacing="10" alignment="CENTER">
                  <Label text="👥" style="-fx-font-size: 48px;"/>
                  <Label text="No employees found"
                         style="-fx-text-fill: #8b949e; -fx-font-size: 16px;"/>
                  <Label text="Click '+ Add New Employee' to get started"
                         style="-fx-text-fill: #6e7681; -fx-font-size: 13px;"/>
               </VBox>
            </placeholder>
         </TableView>
      </VBox>
   </center>

   <!-- BOTTOM - ACTION BUTTONS -->
   <bottom>
      <HBox spacing="12" alignment="CENTER"
            style="-fx-background-color: #1e293b;
                   -fx-border-color: #30363d;
                   -fx-border-width: 1px 0 0 0;
                   -fx-padding: 18px 30px;">

         <!-- ✅ Add -->
         <Button text="➕ Add New Employee"
                 onAction="#addNewEmployee"
                 styleClass="button-success"
                 prefHeight="45"
                 style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 20px;"/>

         <!-- ✅ Edit -->
         <Button text="✏ Edit Selected"
                 onAction="#updateEmployee"
                 prefHeight="45"
                 style="-fx-font-size: 13px; -fx-padding: 0 20px;"/>

         <!-- ✅ Delete -->
         <Button text="🗑 Delete Selected"
                 onAction="#deleteEmployee"
                 styleClass="button-danger"
                 prefHeight="45"
                 style="-fx-font-size: 13px; -fx-padding: 0 20px;"/>

         <!-- ✅ Manage Tasks — NOUVEAU BOUTON VIOLET -->
         <Button text="📋 Manage Tasks"
                 onAction="#openTasks"
                 prefHeight="45"
                 style="-fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-padding: 0 20px;
                       -fx-background-color: #7c3aed;
                       -fx-text-fill: white;
                       -fx-background-radius: 8px;
                       -fx-cursor: hand;"/>

         <Region HBox.hgrow="ALWAYS"/>

         <!-- ✅ Statistics -->
         <Button text="📊 Statistics"
                 onAction="#showStatistics"
                 styleClass="button-secondary"
                 prefHeight="45"
                 style="-fx-font-size: 13px; -fx-padding: 0 20px;"/>

         <!-- ✅ Export -->
         <Button text="📤 Export"
                 onAction="#exportData"
                 styleClass="button-secondary"
                 prefHeight="45"
                 style="-fx-font-size: 13px; -fx-padding: 0 20px;"/>

      </HBox>
   </bottom>

</BorderPane>