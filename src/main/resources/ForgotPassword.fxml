<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ForgotPasswordController"
      spacing="0"
      prefWidth="420" prefHeight="340"
      style="-fx-background-color: #f5f7fa;">

    <!-- ══════════════ HEADER ══════════════ -->
    <VBox style="-fx-background-color: #2c3e50; -fx-padding: 22 30 22 30;">
        <Label text="🔑 Mot de passe oublié"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label text="Récupérez l'accès à votre compte"
               style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;" />
    </VBox>

    <!-- ══════════════ STEP 1 — Email ══════════════ -->
    <VBox fx:id="step1Box" spacing="12"
          style="-fx-padding: 28 30 22 30; -fx-background-color: #f5f7fa;">

        <Label text="Étape 1 / 3 — Entrez votre adresse email"
               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />

        <TextField fx:id="tfEmail"
                   promptText="votre.email@exemple.com"
                   style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                          -fx-border-color: #bdc3c7; -fx-border-radius: 6;" />

        <Button text="Envoyer le code"
                onAction="#handleSendCode"
                maxWidth="Infinity"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 10; -fx-background-radius: 6;
                       -fx-cursor: hand;" />

        <Label fx:id="lblStep1Status" text=""
               style="-fx-font-size: 13px;" wrapText="true" />
    </VBox>

    <!-- ══════════════ STEP 2 — Code ══════════════ -->
    <VBox fx:id="step2Box" spacing="12" visible="false" managed="false"
          style="-fx-padding: 28 30 22 30; -fx-background-color: #f5f7fa;">

        <Label text="Étape 2 / 3 — Entrez le code reçu par email"
               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />

        <TextField fx:id="tfCode"
                   promptText="Code à 6 chiffres"
                   style="-fx-font-size: 18px; -fx-padding: 10; -fx-background-radius: 6;
                          -fx-border-color: #bdc3c7; -fx-border-radius: 6;
                          -fx-alignment: CENTER;" />

        <HBox spacing="10">
            <Button text="Vérifier le code"
                    onAction="#handleVerifyCode"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 10; -fx-background-radius: 6;
                           -fx-cursor: hand;" />
            <Button text="Renvoyer"
                    onAction="#handleResendCode"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-padding: 10; -fx-background-radius: 6;
                           -fx-cursor: hand;" />
        </HBox>

        <Label fx:id="lblStep2Status" text=""
               style="-fx-font-size: 13px;" wrapText="true" />
    </VBox>

    <!-- ══════════════ STEP 3 — New Password ══════════════ -->
    <VBox fx:id="step3Box" spacing="12" visible="false" managed="false"
          style="-fx-padding: 28 30 22 30; -fx-background-color: #f5f7fa;">

        <Label text="Étape 3 / 3 — Choisissez un nouveau mot de passe"
               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />

        <PasswordField fx:id="tfNewPassword"
                       promptText="Nouveau mot de passe (min. 6 caractères)"
                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                              -fx-border-color: #bdc3c7; -fx-border-radius: 6;" />

        <PasswordField fx:id="tfConfirmPassword"
                       promptText="Confirmer le mot de passe"
                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                              -fx-border-color: #bdc3c7; -fx-border-radius: 6;" />

        <Button text="✅ Enregistrer le nouveau mot de passe"
                onAction="#handleResetPassword"
                maxWidth="Infinity"
                style="-fx-background-color: #e67e22; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 10; -fx-background-radius: 6;
                       -fx-cursor: hand;" />

        <Label fx:id="lblStep3Status" text=""
               style="-fx-font-size: 13px;" wrapText="true" />
    </VBox>

</VBox>
