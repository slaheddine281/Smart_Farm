<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.EmailVerificationController"
      spacing="16"
      prefWidth="400" prefHeight="320"
      style="-fx-padding: 25; -fx-background-color: #f8f9fa;"
      alignment="CENTER">

    <Label text="📧 Vérification email"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <Label text="Un code de vérification a été envoyé à :"
           style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />

    <Label fx:id="lblEmail" text="hama@esprit.tn"
           style="-fx-font-weight: bold; -fx-text-fill: #28a745;" />

    <TextField fx:id="tfCode"
               promptText="Entrez le code à 6 chiffres"
               prefWidth="220"
               style="-fx-font-size: 16px; -fx-padding: 10;" />

    <HBox spacing="12" alignment="CENTER">
        <Button text="Valider" onAction="#handleVerifyCode"
                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-min-width: 100;" />
        <Button text="Renvoyer" onAction="#handleResendCode"
                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-min-width: 100;" />
    </HBox>

    <Label fx:id="lblStatus" text=""
           style="-fx-font-size: 14px; -fx-text-fill: #dc3545; -fx-wrap-text: true;"
           prefWidth="350" />

</VBox>