<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DeleteUser"
            stylesheets="@css/delete_user.css">

    <children>
        <VBox spacing="20"
              alignment="CENTER"
              AnchorPane.topAnchor="20"
              AnchorPane.bottomAnchor="20"
              AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="20">

            <Label text="Supprimer utilisateur" styleClass="title"/>
            <Label text="⚠ Cette action est irréversible" styleClass="warning"/>

            <GridPane hgap="15" vgap="12" alignment="CENTER">
                <Label text="Nom :" />
                <Label fx:id="lblNom" GridPane.columnIndex="1"/>

                <Label text="Email :" GridPane.rowIndex="1"/>
                <Label fx:id="lblEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Rôle :" GridPane.rowIndex="2"/>
                <Label fx:id="lblRole" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Supprimer" onAction="#onDelete" styleClass="btn-danger"/>
                <Button text="Annuler" onAction="#onCancel" styleClass="btn-secondary"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
